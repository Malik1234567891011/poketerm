#!/usr/bin/expect -f
# Drive a real Claude Code session for screenshots: trust folder, ask one tiny prompt.
# Raw mode + immediate interact so the terminal's query replies reach claude untouched.
stty raw -echo
spawn -noecho claude
after 6000 { send "\033\[B" }
after 6500 { send "\r" }
after 10000 { send "In one short sentence, what is a Pikachu?" }
after 10800 { send "\r" }
interact
