#!/bin/zsh
# poke — control poketerm
#   poke                       show your party and options
#   poke party pikachu gengar  pin up to 3 followers (run `poke` to list them)
#   poke try [NAME]            show one in a new tab (no NAME: the next one, for a tour)
#   poke order | random        a new partner every window: next in line (default) or random
#   poke wild [NAME] [shiny]   summon a wild encounter
#   poke off | on              turn the shader effects off / back on
#   poke reload                rebuild the shader and reload Ghostty
H=${POKETERM_HOME:-${0:A:h:h}}
SPECIES=(pikachu gengar jigglypuff eevee charmander bulbasaur squirtle snorlax mew psyduck gastly darkrai)
SPECIES+=($H/art/extra/*/anims.json(N:h:t))   # local-only extras (art/extra/, not in git)

reload() {
  local py=$H/tools/.venv/bin/python; [[ -x $py ]] || py=python3
  $py $H/tools/build.py >/dev/null || { print -u2 "build failed"; return 1; }
  print "rebuilt: open a new tab or window to see it (Ghostty compiles shaders per window)"
}

case $1 in
  party)
    shift
    local -a pick=()
    for n in ${(L)@}; do
      (( ${SPECIES[(Ie)$n]} )) || { print -u2 "unknown pokémon: $n (try: $SPECIES)"; exit 1; }
      pick+=$n
    done
    (( ${#pick} >= 1 && ${#pick} <= 3 )) || { print -u2 "pick 1 to 3 of: $SPECIES"; exit 1; }
    print -- "$pick" > $H/party.conf
    reload && print "party: $pick"
    ;;
  try)
    # Ghostty only compiles the shader when a tab opens, so bake this one and open a tab.
    # The new tab's shell sees .try, greets you with it, then puts your party back.
    local name=${(L)2}
    if [[ -z $name ]]; then
      local last=$(<$H/.try-last 2>/dev/null)
      name=${SPECIES[(( (${SPECIES[(Ie)$last]} % ${#SPECIES}) + 1 ))]}
    fi
    (( ${SPECIES[(Ie)$name]} )) || { print -u2 "unknown pokémon: $name (try: $SPECIES)"; exit 1; }
    print -- $name > $H/.try
    print -- $name > $H/.try-last
    reload >/dev/null || exit 1
    osascript -e 'tell application "Ghostty" to new tab in front window' >/dev/null 2>&1 \
      || osascript -e 'tell application "Ghostty" to new window' >/dev/null 2>&1 \
      || { print "$name is ready: open a new tab (⌘T) to see it"; exit 0; }
    print "$name sent to a new tab  ·  \`poke try\` again for the next one"
    ;;
  order|random)
    print $1 > $H/party.conf
    [[ $1 == order ]] && print "a new partner every window, in order: $SPECIES" || print "a random partner every new window"
    ;;
  roster) print -l $SPECIES ;;
  wild)
    POKETERM_HOME=$H source $H/shell/poketerm.zsh
    poke_encounter ${(U)2} $([[ $3 == shiny ]] && print 1)
    ;;
  off)
    sed -i '' 's|^custom-shader = |# custom-shader = |' $H/ghostty/config && reload && print "effects off"
    ;;
  on)
    sed -i '' 's|^# custom-shader = |custom-shader = |' $H/ghostty/config && reload && print "effects on"
    ;;
  reload) reload ;;
  *)
    local conf=$(<$H/party.conf 2>/dev/null)
    if [[ $conf == (|order|random) ]]; then print "party: ${conf:-order}, a new one each window (next: $(<$H/.partner 2>/dev/null))"
    else print "party: $conf (pinned: \`poke order\` to rotate again)"; fi
    print "pokémon: $SPECIES"
    sed -n '2,8p' $0 | sed 's/^# \{0,1\}//'
    ;;
esac
